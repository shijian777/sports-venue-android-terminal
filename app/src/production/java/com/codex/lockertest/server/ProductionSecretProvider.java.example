package com.codex.lockertest.server;

/**
 * Interface-only template. Restore the authorized provider on the build machine.
 * This example deliberately returns no credential and cannot authorize requests.
 * Never commit real credentials or the restored ProductionSecretProvider.java.
 */
public final class ProductionSecretProvider {
    private ProductionSecretProvider() { }

    public static char[] copyOrEmpty() {
        return new char[0];
    }
}
